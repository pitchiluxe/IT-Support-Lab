# ─────────────────────────────────────────────────────────────────────────────
# IT Services Support Technician Lab Academy — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# 3D Campus
# Set to true to enable the 3D campus scene as the default view. The scene
# is lazy-loaded (~900 kB) so learners who prefer 2D see no extra download.
# Default: false
VITE_ENABLE_3D=true

# AI Tutor — Ollama (local)
# Base URL for a locally-running Ollama instance. Defaults to localhost.
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Capstone unlock threshold (0.0 – 1.0)
# Fraction of phase labs a learner must complete before the capstone opens.
# Default: 0.8 (80%)
# VITE_CAPSTONE_THRESHOLD=0.8
